# Use the same Supabase project as the backend. All values here are public.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-or-legacy-anon-key>
# Gemini and service-role keys belong only on the backend/admin machine.
