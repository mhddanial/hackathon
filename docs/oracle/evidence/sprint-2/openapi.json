        "structured_results": {
          "items": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CongestionResult"
              },
              {
                "$ref": "#/components/schemas/ScheduleResult"
              },
              {
                "$ref": "#/components/schemas/RouteResult"
              },
              {
                "$ref": "#/components/schemas/GenericResult"
              }
            ],
            "discriminator": {
              "propertyName": "type",
              "mapping": {
                "congestion": "#/components/schemas/CongestionResult",
                "generic": "#/components/schemas/GenericResult",
                "route": "#/components/schemas/RouteResult",
                "schedule": "#/components/schemas/ScheduleResult"
