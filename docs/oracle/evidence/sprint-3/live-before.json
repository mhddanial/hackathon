  "constraints": [
    {
      "constraint_name": "chat_messages_completed_assistant",
      "definition": "CHECK (((role <> 'assistant'::text) OR (status <> 'completed'::text) OR ((content IS NOT NULL) AND (char_length(btrim(content)) > 0))))",
      "table_name": "chat_messages"
    },
    {
      "constraint_name": "chat_messages_conversation_owner",
      "definition": "FOREIGN KEY (conversation_id, user_id) REFERENCES conversations(id, user_id) ON DELETE CASCADE",
      "table_name": "chat_messages"
    },
    {
      "constraint_name": "chat_messages_data_status_check",
      "definition": "CHECK (((data_status IS NULL) OR (data_status = ANY (ARRAY['synthetic_estimate'::text, 'database'::text, 'estimated'::text, 'default_fallback'::text, 'unknown'::text]))))",
      "table_name": "chat_messages"
    },
    {
      "constraint_name": "chat_messages_identity_owner",
      "definition": "UNIQUE (id, conversation_id, user_id)",
      "table_name": "chat_messages"
    },
    {
      "constraint_name": "chat_messages_order",
      "definition": "UNIQUE (conversation_id, sequence)",
      "table_name": "chat_messages"
    },
    {
      "constraint_name": "chat_messages_pkey",
      "definition": "PRIMARY KEY (id)",
      "table_name": "chat_messages"
    },
    {
      "constraint_name": "chat_messages_request_once",
      "definition": "UNIQUE (user_id, client_request_id)",
      "table_name": "chat_messages"
    },
    {
      "constraint_name": "chat_messages_role_check",
      "definition": "CHECK ((role = ANY (ARRAY['user'::text, 'assistant'::text, 'tool'::text])))",
      "table_name": "chat_messages"
    },
    {
      "constraint_name": "chat_messages_status_check",
      "definition": "CHECK ((status = ANY (ARRAY['in_progress'::text, 'completed'::text, 'failed'::text, 'interrupted'::text])))",
      "table_name": "chat_messages"
    },
    {
      "constraint_name": "chat_messages_structured_results_check",
      "definition": "CHECK ((jsonb_typeof(structured_results) = 'array'::text))",
      "table_name": "chat_messages"
    },
    {
      "constraint_name": "chat_messages_tool_arguments_check",
      "definition": "CHECK (((tool_arguments IS NULL) OR (jsonb_typeof(tool_arguments) = 'object'::text)))",
      "table_name": "chat_messages"
    },
    {
      "constraint_name": "chat_messages_tool_calls_check",
      "definition": "CHECK ((jsonb_typeof(tool_calls) = 'array'::text))",
      "table_name": "chat_messages"
    },
    {
      "constraint_name": "chat_messages_tool_fields",
      "definition": "CHECK (((role <> 'tool'::text) OR ((tool_call_id IS NOT NULL) AND (tool_name IS NOT NULL) AND (tool_arguments IS NOT NULL) AND (tool_result IS NOT NULL))))",
      "table_name": "chat_messages"
    },
    {
      "constraint_name": "chat_messages_tool_name_check",
      "definition": "CHECK (((tool_name IS NULL) OR (tool_name = ANY (ARRAY['get_congestion_level'::text, 'get_ferry_schedule'::text, 'get_optimal_route'::text]))))",
      "table_name": "chat_messages"
    },
    {
      "constraint_name": "chat_messages_tool_result_check",
      "definition": "CHECK (((tool_result IS NULL) OR (jsonb_typeof(tool_result) = 'object'::text)))",
      "table_name": "chat_messages"
    },
    {
      "constraint_name": "chat_messages_turn_owner",
      "definition": "FOREIGN KEY (turn_id, conversation_id, user_id) REFERENCES chat_messages(id, conversation_id, user_id) ON DELETE CASCADE",
      "table_name": "chat_messages"
    },
    {
      "constraint_name": "chat_messages_user_turn",
      "definition": "CHECK ((((role = 'user'::text) AND (id = turn_id) AND (client_request_id IS NOT NULL) AND (content IS NOT NULL) AND ((char_length(btrim(content)) >= 1) AND (char_length(btrim(content)) <= 8000))) OR ((role <> 'user'::text) AND (id <> turn_id) AND (client_request_id IS NULL))))",
      "table_name": "chat_messages"
    },
    {
      "constraint_name": "conversations_id_owner",
      "definition": "UNIQUE (id, user_id)",
      "table_name": "conversations"
    },
    {
      "constraint_name": "conversations_pkey",
      "definition": "PRIMARY KEY (id)",
      "table_name": "conversations"
    },
    {
      "constraint_name": "conversations_title_check",
      "definition": "CHECK (((title IS NULL) OR ((char_length(btrim(title)) >= 1) AND (char_length(btrim(title)) <= 160))))",
      "table_name": "conversations"
    },
    {
      "constraint_name": "conversations_user_id_fkey",
      "definition": "FOREIGN KEY (user_id) REFERENCES auth.users(id) ON DELETE CASCADE",
      "table_name": "conversations"
    },
    {
      "constraint_name": "route_query_log_pkey",
      "definition": "PRIMARY KEY (id)",
      "table_name": "route_query_log"
    },
    {
      "constraint_name": "route_query_log_user_id_fkey",
      "definition": "FOREIGN KEY (user_id) REFERENCES auth.users(id) ON DELETE SET NULL",
      "table_name": "route_query_log"
    }
  ],
